   "source": [
    "G = ct.tf([2.4], [1, 1.2, 0])\n",
    "w = np.logspace(-2, 1, 3000)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(7, 6))\n",
    "carta_nb(ax, xlim=(-200, -60), ylim=(-25, 15))\n",
    "pw, mdb = nb_curve(G, w)\n",
    "ax.plot(pw, mdb, 'b', lw=2, label=r'$G(j\\omega)$')\n",
    "ax.plot(-180, 0, 'r+', ms=13, mew=2, label='ponto crítico')\n",
    "ax.legend(loc='lower left')\n",
    "plt.show()\n",
    "\n",
    "# Mr e ωr medidos diretamente no Bode de malha fechada\n",
    "T = mf(G)\n",
    "mT, _ = mp(T, w)\n",
    "ir = np.argmax(mT)\n",
    "Mr, wr = mT[ir], w[ir]\n",
    "print(f'Mr = {Mr:.2f} vezes = {20*np.log10(Mr):.2f} dB  em  ωr = {wr:.2f} rad/s')\n",
    "\n",
    "# ponte Mr → ξ → Mp\n",
    "xi2 = (1 - math.sqrt(1 - 1/Mr**2))/2\n",
    "xi = math.sqrt(xi2)\n",
    "Mp_prev = 100*math.exp(-math.pi*xi/math.sqrt(1 - xi**2))\n",
    "r = medir(T, np.linspace(0, 10, 20000))\n",
    "print(f'ξ ≈ {xi:.2f}  →  Mp previsto ≈ {Mp_prev:.1f}%   |   simulado: Mp = {r[\"Mp\"]:.1f}%,  tr = {r[\"tr\"]:.2f} s')"
   ]
