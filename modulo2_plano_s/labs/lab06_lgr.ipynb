    "# %% IMPORTS (rode esta célula primeiro)\n",
    "!pip install --quiet control==0.10.2\n",
    "import control as ct\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "plt.rcParams['figure.figsize'] = (8, 5)\n",
    "plt.rcParams['axes.grid'] = True\n",
    "\n",
    "def step(G, t):\n",
    "    t, y = ct.step_response(G, t)\n",
    "    return np.asarray(t), np.asarray(y)\n",
    "\n",
    "def angulo_G(G, ponto):\n",
    "    \"\"\"Fase de G(ponto) em graus: soma dos ângulos dos zeros − soma dos polos.\n",
    "    Usa atan2 — cuidado com o quadrante!\"\"\"\n",
    "    fase = 0.0\n",
    "    for z in ct.zeros(G):\n",
    "        fase += np.degrees(np.arctan2(ponto.imag - z.imag, ponto.real - z.real))\n",
    "    for p in ct.poles(G):\n",
    "        fase -= np.degrees(np.arctan2(ponto.imag - p.imag, ponto.real - p.real))\n",
    "    # normaliza para (-180, 180]\n",
    "    return (fase + 180) % 360 - 180\n",
    "\n",
    "def ganho_LGR(G, ponto, A=1.0):\n",
    "    \"\"\"k = (1/A)·Π dist(ponto→polos) / Π dist(ponto→zeros). NÃO esqueça do A!\"\"\"\n",
    "    dpolos = np.prod([abs(ponto - p) for p in ct.poles(G)])\n",
    "    dzeros = np.prod([abs(ponto - z) for z in ct.zeros(G)]) if len(ct.zeros(G)) else 1.0\n",
    "    return dpolos/(A*dzeros)\n",
    "\n",
    "print('python-control', ct.__version__)"
   ]
  },
