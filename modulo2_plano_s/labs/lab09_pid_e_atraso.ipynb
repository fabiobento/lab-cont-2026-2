     "iopub.status.busy": "2026-08-03T00:16:44.099091Z",
     "iopub.status.idle": "2026-08-03T00:16:44.980333Z",
     "shell.execute_reply": "2026-08-03T00:16:44.979741Z"
    }
   },
   "outputs": [
