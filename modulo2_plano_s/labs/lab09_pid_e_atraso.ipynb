    "# %% IMPORTS (rode esta célula primeiro)\n",
    "!pip install --quiet control==0.10.2\n",
    "import control as ct\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "plt.rcParams['figure.figsize'] = (9, 4)\n",
    "plt.rcParams['axes.grid'] = True\n",
    "\n",
    "def step(G, t):\n",
    "    t, y = ct.step_response(G, t)\n",
    "    return np.asarray(t), np.asarray(y)\n",
    "\n",
    "def medir(T, t=None):\n",
    "    if t is None: t = np.linspace(0, 50, 50000)\n",
    "    t, y = step(T, t)\n",
    "    yss = y[-1]\n",
    "    Mp = 100*(y.max()-yss)/yss; tp = t[np.argmax(y)]\n",
    "    tr = t[np.argmax(y >= yss)]\n",
    "    fora = np.where(np.abs(y-yss) > 0.05*abs(yss))[0]\n",
    "    ts = t[fora[-1]] if len(fora) else 0.0\n",
    "    return dict(Mp=Mp, tp=tp, tr=tr, ts=ts, yss=yss)\n",
    "\n",
    "print('python-control', ct.__version__)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6658e4ce",
   "metadata": {},
   "source": [
    "## Parte 1 — O PID completo (Exercício 2.5.2)\n",
    "\n",
    "$G(s) = \\dfrac{2}{(s+2)(s+5)}$, requisitos $M_p = 16{,}3\\\%$, $t_p = 400$ ms, $e_{ss}(\\text{degrau}) = 0$.\n",
    "Do quadro: $\\square_d = -4{,}6+7{,}9j$, avanço $15{,}3°$, zero do PD em $-33{,}4$, $k = 1{,}1$.\n",
    "Só falta o zero do PI — testamos as três posições da teoria:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "1d01c6ad",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-03T00:16:42.991267Z",
     "iopub.status.busy": "2026-08-03T00:16:42.990735Z",
     "iopub.status.idle": "2026-08-03T00:16:44.097333Z",
     "shell.execute_reply": "2026-08-03T00:16:44.096782Z"
    }
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 900x400 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "G = ct.tf([2], [1, 7, 10])\n",
    "t = np.linspace(0, 14, 14000)\n",
    "for zpi in [0.46, 2, 1]:\n",
    "    Cpid = 1.1*ct.tf([1, 33.4], [1]) * ct.tf([1, zpi], [1, 0])\n",
    "    T = ct.feedback(Cpid*G, 1)\n",
    "    m = medir(T, t)\n",
    "    # kp, ki, kd: expandir (s+33,4)(s+zpi) = s² + (33,4+zpi)s + 33,4·zpi → C = kd·s + kp + ki/s\n",
    "    kp = 1.1*(33.4+zpi); ki = 1.1*33.4*zpi; kd = 1.1\n",
    "    plt.plot(*step(T, t), label=f'zero −{zpi}: Mp = {m[\"Mp\"]:.1f}% | kp={kp:.1f}, ki={ki:.1f}')\n",
    "plt.xlabel('t (s)'); plt.ylabel('y(t)'); plt.legend(fontsize=8)\n",
    "plt.title('PID: a posição do zero do PI decide a convergência e o overshoot');"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5358c111",
   "metadata": {},
   "source": [
