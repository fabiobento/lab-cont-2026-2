     "output_type": "stream",
     "text": [
      "τ = 0.05: k crítico numérico = 44.0 | teoria a+2/τ = 44.0\n",
      "τ = 0.1: k crítico numérico = 24.0 | teoria a+2/τ = 24.0\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
