      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Repare: saturação e zona morta são FUNÇÕES (cada e tem um u); a histerese NÃO — o u depende do histórico.\n"
     ]
    }
   ],
   "source": [
    "# As três não linearidades como funções Python\n",
    "def saturacao(e, k=1.0, s=1.0):\n",
    "    # linear com ganho k ate |e|=s; travada em +-k*s fora\n",
    "    return np.clip(k * e, -k * s, k * s)\n",
    "\n",
    "def zona_morta(e, k=1.0, d=0.5):\n",
    "    # zero para |e|<=d; depois cresce com ganho k\n",
    "    return k * np.sign(e) * np.maximum(np.abs(e) - d, 0)\n",
    "\n",
    "def rele_histerese(vetor_e, d=1.0, h=0.5):\n",
    "    # relé COM MEMÓRIA: liga (+d) quando e>+h; desliga (-d) quando e<-h\n",
    "    u = np.empty_like(vetor_e)\n",
    "    estado = -d                      # começa desligado\n",
    "    for i, e in enumerate(vetor_e):\n",
    "        if e > h:\n",
    "            estado = d\n",
    "        elif e < -h:\n",
    "            estado = -d\n",
    "        u[i] = estado\n",
    "    return u\n",
    "\n",
    "e = np.linspace(-3, 3, 1200)\n",
    "fig, axs = plt.subplots(1, 3, figsize=(14, 3.6))\n",
    "axs[0].plot(e, saturacao(e, k=1.0, s=1.0), 'b', lw=2)\n",
    "axs[0].set_title(\"Saturação ($k=1$, $s=1$)\"); axs[0].set_xlabel(\"e\"); axs[0].set_ylabel(\"u\")\n",
    "axs[1].plot(e, zona_morta(e, k=1.0, d=0.8), 'g', lw=2)\n",
    "axs[1].set_title(\"Zona morta ($k=1$, $d=0{,}8$)\"); axs[1].set_xlabel(\"e\")\n",
    "axs[2].plot(e, rele_histerese(e, d=1.0, h=0.5), 'r', lw=2)\n",
    "axs[2].set_title(\"Relé com histerese ($d=1$, $h=0{,}5$)\"); axs[2].set_xlabel(\"e\")\n",
    "for ax in axs:\n",
    "    ax.grid(alpha=0.3)\n",
    "fig.tight_layout(); plt.show()\n",
    "print(\"Repare: saturação e zona morta são FUNÇÕES (cada e tem um u); a histerese NÃO — o u depende do histórico.\")"
   ]
  },
