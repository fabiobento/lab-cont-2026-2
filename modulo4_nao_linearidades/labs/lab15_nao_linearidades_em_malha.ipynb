    "\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.integrate import solve_ivp\n",
    "import control as ct\n",
    "\n",
    "def metricas(t, y, ref=1.0):\n",
    "    # Sobressinal (%) e tempo de acomodacao (+-5%) em relacao a ref\n",
    "    mp = (y.max() - ref) / ref * 100\n",
    "    idx = np.where(np.abs(y - ref) > 0.05 * ref)[0]\n",
    "    ts = t[idx[-1]] if len(idx) else 0.0\n",
    "    return mp, ts\n",
    "\n",
    "def tr_1090(t, y, ref):\n",
    "    # tempo de subida 10-90% do valor ref\n",
    "    t10 = t[np.argmax(y >= 0.1 * ref)]\n",
    "    t90 = t[np.argmax(y >= 0.9 * ref)]\n",
    "    return t90 - t10\n",
    "\n",
    "print(\"Ambiente pronto. control\", ct.__version__)"
