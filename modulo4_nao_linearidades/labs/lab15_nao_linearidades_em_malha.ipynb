    "def sim_termostato(h, d=1.0, T=200.0):\n",
    "    # Planta de 1a ordem: y' = (-y + u)/10 ; relé com histerese.\n",
    "    # CUIDADO: não-linearidade com MEMÓRIA não deve ser simulada mutando\n",
    "    # estado dentro de f (o solver adaptativo avalia f em pontos rejeitados).\n",
    "    # Solução robusta: integrar trecho a trecho com DETECÇÃO DE EVENTOS.\n",
    "    t_all, y_all, u_all = [], [], []\n",
    "    t0, y0, u = 0.0, 0.0, -d\n",
    "    while t0 < T:\n",
    "        def f(t, x, u=u):\n",
    "            return [(-x[0] + u) / 10]\n",
    "        def ev_sobe(t, x):   # y atinge +h (com u=+d)\n",
    "            return x[0] - h\n",
    "        def ev_desce(t, x):  # y atinge -h (com u=-d)\n",
    "            return x[0] + h\n",
    "        ev = ev_sobe if u > 0 else ev_desce\n",
    "        ev.terminal = True\n",
    "        ev.direction = 1 if u > 0 else -1\n",
    "        sol = solve_ivp(f, [t0, T], [y0], events=ev, dense_output=True,\n",
    "                        rtol=1e-9, atol=1e-12)\n",
    "        tt = np.linspace(t0, sol.t[-1], max(int((sol.t[-1] - t0) * 200), 10))\n",
    "        yy = sol.sol(tt).ravel()\n",
    "        t_all.append(tt); y_all.append(yy); u_all.append(np.full_like(tt, u))\n",
    "        t0, y0 = sol.t[-1], sol.y[0, -1]\n",
    "        if sol.status == 1:      # evento: comuta o relé\n",
    "            u = -u\n",
    "        else:\n",
    "            break                # acabou o horizonte\n",
    "    return (np.concatenate(t_all), np.concatenate(y_all), np.concatenate(u_all))\n",
    "\n",
    "fig, axs = plt.subplots(1, 3, figsize=(14, 3.8), sharey=True)\n",
    "print(f\"{'h':>5} | {'T teórico (s)':>14} | {'T medido (s)':>13} | {'amplitude':>10}\")\n",
    "print(\"-\" * 50)\n",
    "for ax, h, cor in zip(axs, [0.2, 0.5, 0.8], ['b', 'g', 'r']):\n",
    "    t, y, u = sim_termostato(h)\n",
    "    T_teo = 20 * np.log((1 + h) / (1 - h))\n",
    "    # período medido: intervalo entre toques sucessivos no topo (+h)\n",
    "    toques = t[1:][(y[:-1] < h - 1e-6) & (y[1:] >= h - 1e-6)]\n",
    "    T_med = np.mean(np.diff(toques[-6:])) if len(toques) > 2 else np.nan\n",
    "    print(f\"{h:>5} | {T_teo:>14.2f} | {T_med:>13.2f} | {y[t>150].max():>10.3f}\")\n",
    "    ax.plot(t, y, cor, lw=1.5)\n",
    "    ax.axhline(h, color='k', ls=':', lw=1); ax.axhline(-h, color='k', ls=':', lw=1)\n",
    "    ax.set_title(f\"h = {h} → T = {T_teo:.1f} s\")\n",
    "    ax.set_xlabel(\"tempo (s)\"); ax.grid(alpha=0.3); ax.set_xlim(0, 200)\n",
    "axs[0].set_ylabel(\"temperatura $y$\")\n",
    "fig.suptitle(\"Termostato liga-desliga: amplitude = h; período = 20 ln[(1+h)/(1−h)]\", y=1.04)\n",
    "fig.tight_layout(); plt.show()\n",
    "print(\"Amplitude exatamente h e período conforme a fórmula: ciclo-limite EXATO, sem função descritiva.\")"
   ]
