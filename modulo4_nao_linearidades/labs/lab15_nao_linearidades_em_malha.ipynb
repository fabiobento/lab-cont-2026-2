    "def sim_p_sat(kp, sat, r, T=15.0, npts=15000):\n",
    "    # planta G=1/(s+1)^2 :  y'' = -2 y' - y + u\n",
    "    def f(t, x):\n",
    "        y, dy = x\n",
    "        e = r - y\n",
    "        u = kp * e\n",
    "        u = min(max(u, -sat), sat)   # atuador real\n",
    "        return [dy, -2 * dy - y + u]\n",
    "    t = np.linspace(0, T, npts)\n",
    "    sol = solve_ivp(f, [0, T], [0.0, 0.0], t_eval=t, rtol=1e-8, atol=1e-10)\n",
    "    return t, sol.y[0]\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8.5, 4.6))\n",
    "print(f\"{'r':>4} | {'Mp (%)':>8} | {'tr 10-90% (s)':>14} | {'ts ±5% (s)':>10}\")\n",
    "print(\"-\" * 46)\n",
    "for r, cor in [(0.5, 'b'), (1.0, 'g'), (2.0, 'r')]:\n",
    "    t, y = sim_p_sat(3.0, 2.0, r)\n",
    "    yss = 0.75 * r                      # ganho DC da MF: kp/(1+kp) = 0,75\n",
    "    mp = (y.max() - yss) / yss * 100\n",
    "    tr = tr_1090(t, y, yss)\n",
    "    idx = np.where(np.abs(y - yss) > 0.05 * yss)[0]\n",
    "    ts = t[idx[-1]] if len(idx) else 0.0\n",
    "    print(f\"{r:>4} | {mp:>8.1f} | {tr:>14.2f} | {ts:>10.2f}\")\n",
    "    ax.plot(t, y / yss, cor, lw=2, label=f\"r = {r} (normalizado)\")\n",
    "ax.plot(t, np.ones_like(t), 'k--', lw=1)\n",
    "ax.set_xlabel(\"tempo (s)\"); ax.set_ylabel(\"$y / y_{ss}$\")\n",
    "ax.set_title(\"Saturação ±2: a resposta normalizada MUDA com a amplitude do degrau\")\n",
    "ax.legend(); ax.grid(alpha=0.3); ax.set_xlim(0, 8); plt.show()\n",
    "print(\"Pela teoria linear, as três curvas seriam IDÊNTICAS (Mp=16,3%, tr=0,82 s).\")"
   ]
