    "def sim_dz(kp, d, r, T=20.0, npts=20000, com_zm=True):\n",
    "    def f(t, x):\n",
    "        y, dy = x\n",
    "        e = r - y\n",
    "        uc = kp * e\n",
    "        u = np.sign(uc) * max(abs(uc) - d, 0) if com_zm else uc\n",
    "        return [dy, -2 * dy - y + u]\n",
    "    t = np.linspace(0, T, npts)\n",
    "    sol = solve_ivp(f, [0, T], [0.0, 0.0], t_eval=t, rtol=1e-8, atol=1e-10)\n",
    "    return t, sol.y[0]\n",
    "\n",
    "d, r = 0.5, 2.0\n",
    "print(f\"{'kp':>4} | {'yss com ZM':>10} | {'yss teórico':>12} | {'yss sem ZM':>10} | {'erro extra':>10} | {'d/(1+kp)':>8}\")\n",
    "print(\"-\" * 70)\n",
    "fig, ax = plt.subplots(figsize=(8.5, 4.2))\n",
    "for kp, cor in [(4.0, 'b'), (10.0, 'r')]:\n",
    "    t, y = sim_dz(kp, d, r)\n",
    "    yss_teo = (kp * r - d) / (1 + kp)\n",
    "    yss_lin = kp * r / (1 + kp)\n",
    "    print(f\"{kp:>4} | {y[-1]:>10.3f} | {yss_teo:>12.3f} | {yss_lin:>10.3f} | {yss_lin - y[-1]:>10.3f} | {d/(1+kp):>8.3f}\")\n",
    "    ax.plot(t, y, cor, lw=2, label=f\"$k_p$ = {kp} (com zona morta)\")\n",
    "    ax.axhline(yss_lin, color=cor, ls=':', lw=1)\n",
    "ax.axhline(r, color='k', ls='--', lw=1, label=\"referência r = 2\")\n",
    "ax.set_xlabel(\"tempo (s)\"); ax.set_ylabel(\"$y(t)$\")\n",
    "ax.set_title(\"Zona morta d = 0,5: a saída estaciona ANTES do alvo — e o ganho só ameniza\")\n",
