    "def sim_rele(x0, T=40.0, npts=80000, d=1.0):\n",
    "    # planta 1/[s(s+1)(s+2)]:  d3y = -3 d2y - 2 dy + u ;  relé ideal: u = ±d\n",
    "    def f(t, x):\n",
    "        y = x[0]\n",
    "        e = -y\n",
    "        u = d if e > 0 else (-d if e < 0 else 0.0)\n",
    "        return [x[1], x[2], -3 * x[2] - 2 * x[1] + u]\n",
    "    t = np.linspace(0, T, npts)\n",
    "    sol = solve_ivp(f, [0, T], x0, t_eval=t, rtol=1e-8, atol=1e-10)\n",
    "    return t, sol.y[0], sol.y[1]\n",
    "\n",
    "t_cl, y_cl, dy_cl = sim_rele([0.5, 0.0, 0.0])\n",
    "\n",
    "# Medição no regime (t > 20 s): amplitude e período pelos cruzamentos de zero\n",
    "mask = t_cl > 20\n",
    "yy, tt = y_cl[mask], t_cl[mask]\n",
    "A_sim = (yy.max() - yy.min()) / 2\n",
    "zc = tt[1:][(yy[:-1] < 0) & (yy[1:] >= 0)]\n",
    "T_sim = np.mean(np.diff(zc))\n",
    "w_sim = 2 * np.pi / T_sim\n",
    "A_prev, w_prev = 4 / (6 * np.pi), np.sqrt(2)\n",
    "print(f\"Amplitude: prevista {A_prev:.4f} | simulada {A_sim:.4f} | erro {(A_sim/A_prev-1)*100:.1f}%\")\n",
    "print(f\"Frequência: prevista {w_prev:.3f} | simulada {w_sim:.3f} | erro {(w_sim/w_prev-1)*100:.1f}%\")\n",
    "print(f\"Período: previsto {2*np.pi/w_prev:.3f} s | simulado {T_sim:.3f} s\")\n",
    "\n",
    "fig, axs = plt.subplots(1, 2, figsize=(12.5, 4.2))\n",
    "axs[0].plot(t_cl, y_cl, 'b', lw=1.6)\n",
    "axs[0].axhline(A_prev, color='r', ls='--', lw=1, label=f\"A previsto = {A_prev:.3f}\")\n",
