    "def fd_numerica(nl, A, w=1.0, nper=20, npts=20000):\n",
    "    # Mede N(A) por Fourier: aplica e(t)=A*sen(wt), extrai o 1o harmônico da saída\n",
    "    t = np.linspace(0, nper * 2 * np.pi / w, npts)\n",
    "    x = A * np.sin(w * t)\n",
    "    y = nl(x)\n",
    "    a1 = 2 * np.trapezoid(y * np.sin(w * t), t) / (nper * 2 * np.pi / w)\n",
    "    b1 = 2 * np.trapezoid(y * np.cos(w * t), t) / (nper * 2 * np.pi / w)\n",
    "    return (a1 + 1j * b1) / A\n",
    "\n",
    "def fd_sat_teo(A, k=1.0, s=1.0):\n",
    "    if A <= s: return k\n",
    "    return (2 * k / np.pi) * (np.arcsin(s / A) + (s / A) * np.sqrt(1 - (s / A)**2))\n",
    "\n",
    "def fd_zm_teo(A, k=1.0, d=0.5):\n",
    "    if A <= d: return 0.0\n",
    "    return k - (2 * k / np.pi) * (np.arcsin(d / A) + (d / A) * np.sqrt(1 - (d / A)**2))\n",
    "\n",
    "def rele_hist_nl(vetor_x, d=1.0, h=0.5):\n",
    "    u = np.empty_like(vetor_x); estado = d\n",
    "    for i, xi in enumerate(vetor_x):\n",
    "        if xi > h: estado = d\n",
    "        elif xi < -h: estado = -d\n",
    "        u[i] = estado\n",
    "    return u\n",
    "\n",
    "print(f\"{'A':>5} | {'RELÉ num':>9} {'teo':>7} | {'SAT num':>8} {'teo':>7} | {'ZM num':>8} {'teo':>7}\")\n",
    "print(\"-\" * 64)\n",
    "for A in [0.5, 1.0, 2.0, 5.0]:\n",
    "    nr = fd_numerica(lambda x: np.sign(x), A).real\n",
    "    ns = fd_numerica(lambda x: np.clip(x, -1, 1), A).real\n",
    "    nz = fd_numerica(lambda x: np.sign(x) * np.maximum(np.abs(x) - 0.5, 0), A).real\n",
    "    print(f\"{A:>5} | {nr:>9.4f} {4/(np.pi*A):>7.4f} | {ns:>8.4f} {fd_sat_teo(A):>7.4f} | {nz:>8.4f} {fd_zm_teo(A):>7.4f}\")\n",
    "\n",
    "print()\n",
    "print(\"Relé com histerese (d=1, h=0,5): |N| e fase\")\n",
    "for A in [1.0, 2.0]:\n",
    "    nh = fd_numerica(rele_hist_nl, A)\n",
    "    print(f\"A={A}: num |N|={abs(nh):.4f} fase={np.degrees(np.angle(nh)):6.2f}° | teo |N|={4/(np.pi*A):.4f} fase={-np.degrees(np.arcsin(0.5/A)):6.2f}°\")"
   ]
