    "# (3-5) PID-ZN -> refinamento -> atuador real (saturação) + anti-windup\n",
    "def sim_pid(kp, ki, kd, sat=None, aw=False, r=1.0, T=30.0, npts=30000, N_filt=10.0):\n",
    "    # Planta 1/[s(s+1)(s+2)]: d3y = -3 d2y - 2 dy + u\n",
    "    # PID industrial: derivada FILTRADA atuando SOBRE A MEDIÇÃO (-y):\n",
    "    #   xf' = Nf*(-y - xf);  u_D = kd*xf'   (evita o \"chute derivativo\")\n",
    "    Nf = N_filt\n",
    "    def f(t, x):\n",
    "        y, dy, ddy, xi, xf = x\n",
    "        e = r - y\n",
    "        dxf = Nf * (-y - xf)\n",
    "        u_unsat = kp * e + ki * xi + kd * dxf\n",
    "        u = min(max(u_unsat, -sat), sat) if sat is not None else u_unsat\n",
    "        dxi = e\n",
    "        if aw and sat is not None:\n",
    "            if (u_unsat >= sat and e > 0) or (u_unsat <= -sat and e < 0):\n",
    "                dxi = 0.0    # clamping\n",
    "        return [dy, ddy, -3 * ddy - 2 * dy + u, dxi, dxf]\n",
    "    t = np.linspace(0, T, npts)\n",
    "    sol = solve_ivp(f, [0, T], [0.0] * 5, t_eval=t, rtol=1e-7, atol=1e-9)\n",
    "    return t, sol.y[0]\n",
    "\n",
    "# (3) PID com a sintonia ZN crua\n",
    "t, y_zn = sim_pid(kp_zn, ki_zn, kd_zn)\n",
    "mp_zn, ts_zn = metricas(t, y_zn)\n",
    "\n",
    "# (4) Refinamento típico: -30% em kp, -75% em ki, +50% em kd\n",
    "kp_f, ki_f, kd_f = 0.7 * kp_zn, 0.25 * ki_zn, 1.5 * kd_zn\n",
    "t, y_rf = sim_pid(kp_f, ki_f, kd_f)\n",
    "mp_rf, ts_rf = metricas(t, y_rf)\n",
    "\n",
    "# (5) Atuador real: saturação ±1,0 — sem e com clamping\n",
    "t, y_sat = sim_pid(kp_f, ki_f, kd_f, sat=1.0)\n",
    "t, y_aw = sim_pid(kp_f, ki_f, kd_f, sat=1.0, aw=True)\n",
    "mp_sat, ts_sat = metricas(t, y_sat)\n",
    "mp_aw, ts_aw = metricas(t, y_aw)\n",
    "\n",
    "print(f\"{'configuração':>38} | {'Mp (%)':>7} | {'ts ±5% (s)':>10}\")\n",
    "print(\"-\" * 62)\n",
    "print(f\"{'PID-ZN (ideal, sem saturação)':>38} | {mp_zn:>7.1f} | {ts_zn:>10.2f}\")\n",
    "print(f\"{'PID refinado (ideal)':>38} | {mp_rf:>7.1f} | {ts_rf:>10.2f}\")\n",
    "print(f\"{'PID refinado + saturação ±1,0':>38} | {mp_sat:>7.1f} | {ts_sat:>10.2f}\")\n",
    "print(f\"{'PID refinado + saturação + clamping':>38} | {mp_aw:>7.1f} | {ts_aw:>10.2f}\")\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(9, 4.6))\n",
    "ax.plot(t, y_zn, 'gray', lw=1.6, label=f\"ZN cru: $M_p$ = {mp_zn:.0f} %\")\n",
    "ax.plot(t, y_rf, 'g', lw=1.8, label=f\"refinado (ideal): $M_p$ = {mp_rf:.0f} %\")\n",
    "ax.plot(t, y_sat, 'r', lw=1.8, label=f\"refinado + sat ±1,0: $M_p$ = {mp_sat:.0f} %\")\n",
    "ax.plot(t, y_aw, 'b', lw=2.0, label=f\"refinado + sat + anti-windup: $M_p$ = {mp_aw:.0f} %\")\n",
