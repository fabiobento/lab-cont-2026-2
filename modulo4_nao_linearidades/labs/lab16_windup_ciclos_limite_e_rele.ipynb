    "def sim_pi_windup(kp, ki, tau, sat=None, aw=False, r=1.0, T=150.0, npts=20000):\n",
    "    # planta G = 1/(tau s + 1):  y' = (-y + u)/tau\n",
    "    # estados: [y, xi]  (xi = integrador)\n",
    "    def f(t, x):\n",
    "        y, xi = x\n",
    "        e = r - y\n",
    "        u_unsat = kp * e + ki * xi\n",
    "        u = min(max(u_unsat, -sat), sat) if sat is not None else u_unsat\n",
    "        dxi = e\n",
    "        if aw and sat is not None:\n",
    "            # CLAMPING: congela se saturado E o erro pede mais\n",
    "            if (u_unsat >= sat and e > 0) or (u_unsat <= -sat and e < 0):\n",
    "                dxi = 0.0\n",
    "        return [(-y + u) / tau, dxi]\n",
    "    t = np.linspace(0, T, npts)\n",
    "    sol = solve_ivp(f, [0, T], [0.0, 0.0], t_eval=t, rtol=1e-6, atol=1e-8)\n",
    "    y, xi = sol.y\n",
    "    u_unsat = kp * (r - y) + ki * xi\n",
    "    u = np.clip(u_unsat, -sat, sat) if sat is not None else u_unsat\n",
    "    return t, y, u, u_unsat\n",
    "\n",
    "KP, KI, SAT = 2.0, 0.5, 1.3\n",
    "t, y_id, u_id, uu_id = sim_pi_windup(KP, KI, 10.0, sat=None)\n",
    "t, y_wd, u_wd, uu_wd = sim_pi_windup(KP, KI, 10.0, sat=SAT)\n",
    "t, y_aw, u_aw, uu_aw = sim_pi_windup(KP, KI, 10.0, sat=SAT, aw=True)\n",
    "\n",
    "print(f\"{'cenário':>28} | {'Mp (%)':>7} | {'ts ±5% (s)':>10}\")\n",
    "print(\"-\" * 52)\n",
    "for nome, y in [(\"PI ideal (sem saturação)\", y_id),\n",
    "                (\"PI com saturação ±1,3\", y_wd),\n",
    "                (\"PI com saturação + clamping\", y_aw)]:\n",
    "    mp, ts = metricas(t, y)\n",
    "    print(f\"{nome:>28} | {mp:>7.1f} | {ts:>10.2f}\")\n",
    "\n",
    "fig, axs = plt.subplots(2, 1, figsize=(9, 6.4), sharex=True)\n",
    "axs[0].plot(t, y_id, 'k--', lw=1.4, label=\"ideal (sem saturação)\")\n",
    "axs[0].plot(t, y_wd, 'r', lw=2, label=\"saturação ±1,3 (windup)\")\n",
    "axs[0].plot(t, y_aw, 'b', lw=2, label=\"saturação + clamping\")\n",
    "axs[0].axhline(1, color='gray', ls=':', lw=1)\n",
    "axs[0].set_ylabel(\"$y(t)$\"); axs[0].legend(fontsize=9); axs[0].grid(alpha=0.3)\n",
    "axs[0].set_title(\"Windup: o integrador cheio cobra seu preço DEPOIS do cruzamento\")\n",
    "axs[1].plot(t, uu_wd, 'r--', lw=1.2, label=\"$u_{PI}$ pedido (windup)\")\n",
    "axs[1].plot(t, u_wd, 'r', lw=1.8, label=\"$u$ aplicado (windup)\")\n",
    "axs[1].plot(t, uu_aw, 'b--', lw=1.2, label=\"$u_{PI}$ pedido (clamping)\")\n",
    "axs[1].plot(t, u_aw, 'b', lw=1.8, label=\"$u$ aplicado (clamping)\")\n",
    "axs[1].axhline(SAT, color='gray', ls=':', lw=1); axs[1].axhline(-SAT, color='gray', ls=':', lw=1)\n",
    "axs[1].set_xlabel(\"tempo (s)\"); axs[1].set_ylabel(\"controle\"); axs[1].legend(fontsize=8)\n",
    "axs[1].grid(alpha=0.3); axs[1].set_xlim(0, 100)\n",
    "fig.tight_layout(); plt.show()"
